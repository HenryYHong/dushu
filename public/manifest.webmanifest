{
  "name": "Globereader",
  "short_name": "Globereader",
  "description": "Read real books in Chinese, Japanese, Spanish, French, German, Italian, Portuguese, Russian and English, with readings, definitions and translation on tap.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "lang": "en",
  "categories": [
    "education",
    "books"
  ],
  "background_color": "#f6f2ea",
  "theme_color": "#f6f2ea",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/epub+zip": [
          ".epub"
        ],
        "application/x-mobipocket-ebook": [
          ".mobi",
          ".azw3",
          ".azw"
        ]
      }
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "books",
          "accept": [
            ".epub",
            ".mobi",
            ".azw3",
            ".azw",
            ".txt",
            ".pdf",
            ".html",
            ".htm",
            ".md",
            "application/epub+zip",
            "application/x-mobipocket-ebook",
            "application/pdf",
            "text/plain",
            "text/html",
            "text/markdown"
          ]
        }
      ]
    }
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
