[
  {"id": "hlm-daiyu-leftovers", "book": "hongloumeng", "cat": "dialogue", "find": "黛玉冷笑道：「我就知道，別人不挑剩下的也不給我。」", "split": "dev"},
  {"id": "hlm-jiamu-blind", "book": "hongloumeng", "cat": "idiom", "find": "賈母道：「讀的是什麼書，不過是認得兩個字，不是睜眼的瞎子罷了！」", "split": "held"},
  {"id": "hlm-xifeng-soft", "book": "hongloumeng", "cat": "function-words", "find": "鳳姐道：「我成日家說你太軟弱了，縱的家裡人這樣還了得了。」", "split": "dev"},
  {"id": "hlm-lifeblood", "book": "hongloumeng", "cat": "figurative", "find": "你生氣，要打罵人容易，何苦摔那命根子！", "split": "held"},
  {"id": "hlm-monk-daoist", "book": "hongloumeng", "cat": "names", "find": "寶玉未及回言，只見舡頭上來了兩人，一僧一道，夾住寶玉說道：「俗緣已畢，還不快走。」", "split": "dev"},
  {"id": "hlm-pinger-forgive", "book": "hongloumeng", "cat": "proverb", "find": "平兒笑道：「『得饒人處且饒人』，得省的將就些事也罷了。", "split": "dev"},
  {"id": "hlm-wang-indulged", "book": "hongloumeng", "cat": "pronouns", "find": "王夫人笑道：「你不知道原故：他與別人不同，自幼因老太太疼愛，原系同姊妹們一處嬌養慣了的。", "split": "held"},
  {"id": "hlm-daiyu-school", "book": "hongloumeng", "cat": "numbers", "find": "黛玉道：「不曾讀，只上了一年學，些須認得幾個字。」", "split": "dev"},
  {"id": "hlm-liu-laolao-ask", "book": "hongloumeng", "cat": "address-terms", "find": "劉姥姥陪笑道：「我找太太的陪房周大爺的，煩那位太爺替我請他老出來。」", "split": "held"},
  {"id": "hlm-liu-laolao-advise", "book": "hongloumeng", "cat": "narration", "find": "因此劉姥姥看不過，乃勸道：「姑爺，你別嗔著我多嘴。", "split": "dev"},
  {"id": "hlm-li-gui", "book": "hongloumeng", "cat": "negation", "find": "李貴笑道：“不怕你老人家惱我，素日你老人家到底有些不正經，所以這些兄弟才不聽。", "split": "dev"},
  {"id": "hlm-just-in-time", "book": "hongloumeng", "cat": "function-words", "find": "臺磯之上，坐著幾個穿紅著綠的丫頭，一見他們來了，便忙都笑迎上來，說：「剛纔老太太還念呢，可巧就來了。」", "split": "held"},
  {"id": "hlm-opening-zhen", "book": "hongloumeng", "cat": "names-pun", "find": "作者自云：因曾歷過一番夢幻之後，故將真事隱去，而借通靈之說，撰此《石頭記》一書也。", "split": "dev"},
  {"id": "xyj-wukong-delight", "book": "xiyouji", "cat": "idiom", "find": "孫悟空在傍聞講，喜得他抓耳撓腮，眉花眼笑，忍不住手之舞之，足之蹈之。", "split": "dev"},
  {"id": "xyj-patriarch-scold", "book": "xiyouji", "cat": "dialogue", "find": "祖師聞言，咄的一聲，跳下高臺，手持戒尺，指定悟空道：「你這猢猻，這般不學，那般不學，卻待怎麼？」", "split": "held"},
  {"id": "xyj-transformations", "book": "xiyouji", "cat": "numbers", "find": "有一般天罡數，該三十六般變化；有一般地煞數，該七十二般變化。", "split": "dev"},
  {"id": "xyj-one-opens", "book": "xiyouji", "cat": "idiom", "find": "這猴王也是他一竅通時百竅通，當時習了口訣，自修自煉，將七十二般變化都學成了。", "split": "held"},
  {"id": "xyj-cloud-somersault", "book": "xiyouji", "cat": "terms", "find": "悟空道：「我自聞道之後，有七十二般地煞變化之功，觔斗雲有莫大的神通；善能隱身遯身，起法攝法。", "split": "dev"},
  {"id": "xyj-que-shuo-temple", "book": "xiyouji", "cat": "function-words", "find": "卻說他師徒兩個策馬前來，直至山門首觀看，果然是一座寺院。", "split": "dev"},
  {"id": "xyj-bajie-dates", "book": "xiyouji", "cat": "numbers", "find": "卻說那八戒一則饑，二則渴，原來是食腸大大的，見那鍾子裡有三個紅棗兒，拿起來嘓的都咽在肚裡。", "split": "held"},
  {"id": "xyj-demon-king", "book": "xiyouji", "cat": "idiom", "find": "卻說那個妖王在洞裡歡喜道：「小的們，孫行者吃了虧去了。", "split": "dev"},
  {"id": "xyj-pills", "book": "xiyouji", "cat": "rhetorical", "find": "我只見醋糊為丸，陳米糊為丸，煉蜜為丸，或只是清水為丸，那曾見馬尿為丸？", "split": "held"},
  {"id": "xyj-sanzang-date", "book": "xiyouji", "cat": "dates", "find": "卻說三藏自貞觀十三年九月望前三日，蒙唐王與多官送出長安關外。", "split": "dev"},
  {"id": "sg-three-visits", "book": "sanguo", "cat": "double-negation", "find": "孔明囑付曰：「吾受劉皇叔三顧之恩，不容不出。", "split": "dev"},
  {"id": "sg-tripod-plan", "book": "sanguo", "cat": "classical", "find": "先取荊州為家，後即取西川建基業，以成鼎足之勢，然後可圖中原也。」", "split": "held"},
  {"id": "sg-xuande-lineage", "book": "sanguo", "cat": "numbers", "find": "玄德曰：「備乃中山靖王之後；自涿郡剿戮黃巾，大小三十餘戰，頗有微功，因得除今職。」", "split": "dev"},
  {"id": "sg-oath-brothers", "book": "sanguo", "cat": "rhetorical", "find": "玄德曰：「我三人義同生死，豈可相離？", "split": "held"},
  {"id": "sg-no-plunder", "book": "sanguo", "cat": "idiom", "find": "玄德曰：「我與民秋毫無犯，那得財物與他？」", "split": "dev"},
  {"id": "sg-ma-su", "book": "sanguo", "cat": "conditional", "find": "馬謖在山上見之，大笑曰：「彼若有命，不來圍山。」", "split": "dev"},
  {"id": "sg-kongming-camp", "book": "sanguo", "cat": "rhetorical", "find": "孔明看訖，拍案叫苦曰：「是何人教主上如此下寨？", "split": "held"},
  {"id": "sg-zhang-fei-vow", "book": "sanguo", "cat": "vow", "find": "張飛性起，向玄德換了坐下馬，搶出陣來，叫曰：「我捉你不得，誓不上關！」", "split": "dev"},
  {"id": "sg-lu-zhi", "book": "sanguo", "cat": "titles", "find": "玄德曰：「近聞中郎將盧植與賊首張角戰於廣宗，備昔曾師事盧植，欲往助之。」", "split": "held"},
  {"id": "sg-sima-yi-wrong", "book": "sanguo", "cat": "classical", "find": "行到赤岸坡，見蜀兵已去遠，乃引還，顧謂眾將曰：「孔明已死，我等皆高枕無憂矣！」", "split": "dev"},
  {"id": "sh-only-so", "book": "shuihu", "cat": "vernacular", "find": "武松道：「只好恁地，卻又來望哥哥。」", "split": "dev"},
  {"id": "sh-what-state", "book": "shuihu", "cat": "vernacular", "find": "張青大驚，連忙問道：「賢弟如何恁地模樣？」", "split": "held"},
  {"id": "sh-temple-ruin", "book": "shuihu", "cat": "vernacular", "find": "智深尋思道：「這個大寺，如何敗落的恁地？」", "split": "dev"},
  {"id": "sh-zhishen-bianliao", "book": "shuihu", "cat": "function-words", "find": "智深道：「胡亂賣些與洒家喫，俺須不說是你家便了。」", "split": "held"},
  {"id": "sh-luda-go", "book": "shuihu", "cat": "function-words", "find": "魯達道：「恁地時，洒家自去便了。」", "split": "dev"},
  {"id": "sh-song-jiang-bow", "book": "shuihu", "cat": "kinship", "find": "宋江道：「兄弟，卻是你殺了小衙內，雖是軍師嚴令，論齒序他也是你哥哥，且看我面，與他伏個禮，我卻自拜你便了。」", "split": "dev"},
  {"id": "sh-village-tavern", "book": "shuihu", "cat": "sense-tavern", "find": "當下深、沖、超、霸四人在村酒店中坐下，喚酒保買五七斤肉，打兩角酒來喫，回些麵來打餅。", "split": "held"},
  {"id": "sh-sign-three-bowls", "book": "shuihu", "cat": "sense-tavern", "find": "酒家道：「客官，你須見我門前招旗上面明明寫道：『三碗不過岡』。」", "split": "dev"},
  {"id": "sh-why-three-bowls", "book": "shuihu", "cat": "sense-tavern", "find": "酒家道：「俺家的酒雖是村酒，卻比老酒的滋味；但凡客人來我店中，喫了三碗的，便醉了，過不得前面的山岡去，因此喚做『三碗不過岡』。", "split": "held"},
  {"id": "sh-dai-zong", "book": "shuihu", "cat": "vernacular", "find": "戴宗連忙回轉身來問道：「壯士素不曾拜識，如何呼喚賤名？」", "split": "dev"},
  {"id": "sh-rice", "book": "shuihu", "cat": "numbers", "find": "見我管待客人在此喫酒，你便與他三五升米便了，何須直來問我！」", "split": "dev"},
  {"id": "sh-mouth-bland", "book": "shuihu", "cat": "idiom", "find": "趙員外這幾日又不使人送些東西來與洒家喫，口中淡出鳥來。", "split": "held"},
  {"id": "ky-shop-layout", "book": "kong-yiji", "cat": "sense-tavern", "find": "鲁镇的酒店的格局，是和别处不同的：都是当街一个曲尺形的大柜台，柜里面豫备着热水，可以随时温酒。", "split": "dev"},
  {"id": "ky-prices", "book": "kong-yiji", "cat": "numbers", "find": "做工的人，傍午傍晚散了工，每每花四文铜钱，买一碗酒——这是二十多年前的事，现在每碗要涨到十文，——靠柜外站着，热热的喝了休息；", "split": "held"},
  {"id": "ky-debt", "book": "kong-yiji", "cat": "numbers", "find": "到了年关，掌柜取下粉板说：『孔乙己还欠十九个钱呢！』", "split": "dev"},
  {"id": "ky-dead", "book": "kong-yiji", "cat": "hedging", "find": "我到现在终于没有见——大约孔乙己的确死了。", "split": "held"},
  {"id": "ky-steal-books", "book": "kong-yiji", "cat": "dialogue", "find": "孔乙己便涨红了脸，额上的青筋条条绽出，争辩道：『窃书不能算偸……窃书！……读书人的事，能算偸么？』", "split": "dev"},
  {"id": "ky-hui-character", "book": "kong-yiji", "cat": "language", "find": "又好笑，又不耐烦，懒懒的答他道：『谁要你教，不是草头底下一个来回的回字么？』", "split": "dev"},
  {"id": "gx-runtu-name", "book": "guxiang", "cat": "names-pun", "find": "我的父亲允许了；我也很高兴，因为我早听到闰土这名字，而且知道他和我仿佛年纪，闰月生的，五行缺土，所以他的父亲叫他闰土。", "split": "dev"},
  {"id": "gx-road", "book": "guxiang", "cat": "abstract", "find": "这正如地上的路，其实地上本没有路；走的人多了，也便成了路。", "split": "held"},
  {"id": "gx-hope", "book": "guxiang", "cat": "abstract", "find": "现在我所谓希望，不也是我自己手制的偶像么？", "split": "dev"},
  {"id": "gx-melon", "book": "guxiang", "cat": "negation", "find": "走路的人口渴了摘一个瓜吃，我们这里是不算偸的。", "split": "held"},
  {"id": "kr-teeth", "book": "kuangren-riji", "cat": "figurative", "find": "我看出他话中全是毒，笑中全是刀，他们的牙齿，全是白厉厉的排着，这就是吃人的家伙。", "split": "dev"},
  {"id": "kr-book", "book": "kuangren-riji", "cat": "quotation", "find": "我横竖睡不着，仔细看了半夜，才从字缝里看出字来，满本都写着两个字是『吃人』！", "split": "held"},
  {"id": "kr-brave", "book": "kuangren-riji", "cat": "negation", "find": "我也不怕；虽然不吃人，胆子却比他们还壮。", "split": "dev"},
  {"id": "ly-learning", "book": "lunyu-xue-er", "cat": "classical", "find": "子曰：「學而時習之，不亦說乎？有朋自遠方來，不亦樂乎？人不知而不慍，不亦君子乎？」", "split": "dev"},
  {"id": "ly-three-checks", "book": "lunyu-xue-er", "cat": "classical", "find": "曾子曰：「吾日三省吾身：爲人謀而不忠乎？與朋友交而不信乎？傳不習乎？」", "split": "held"},
  {"id": "ly-clever-words", "book": "lunyu-xue-er", "cat": "classical", "find": "子曰：「巧言令色，鮮矣仁。」", "split": "dev"},
  {"id": "ly-not-known", "book": "lunyu-xue-er", "cat": "classical-negation", "find": "子曰：「不患人之不己知，患不知人也。」", "split": "held"},
  {"id": "ly-gentleman-eats", "book": "lunyu-xue-er", "cat": "classical", "find": "子曰：「君子食無求飽，居無求安，敏於事而愼於言，就有道而正焉：可謂好學也已。」", "split": "dev"},
  {"id": "ly-poor-flatter", "book": "lunyu-xue-er", "cat": "classical-dialogue", "find": "子貢曰：「貧而無諂，富而無驕，何如？」子曰：「可也。未若貧而樂，富而好禮者也」。", "split": "dev"},
  {"id": "tang-moonlight", "book": "tang-poems", "cat": "poem", "find": "牀前明月光，疑是地上霜。\n舉頭望明月，低頭思故鄉。", "split": "dev"},
  {"id": "tang-spring-dawn", "book": "tang-poems", "cat": "poem", "find": "春眠不覺曉，處處聞啼鳥。\n夜來風雨聲，花落知多少。", "split": "held"},
  {"id": "tang-red-beans", "book": "tang-poems", "cat": "poem", "find": "紅豆生南國，春來發幾枝。\n願君多采擷，此物最相思。", "split": "dev"},
  {"id": "tang-wanderer", "book": "tang-poems", "cat": "poem", "find": "臨行密密縫，意恐遲遲歸。\n誰言寸草心，報得三春暉。", "split": "held"},
  {"id": "tang-river-snow", "book": "tang-poems", "cat": "poem", "find": "千山鳥飛絕，萬徑人蹤滅。\n孤舟簑笠翁，獨釣寒江雪。", "split": "dev"}
]
